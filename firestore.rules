rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Hanya konsol tepercaya/Admin SDK ber-IAM yang dapat memprovisikan izin.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /shared/santripulang {
      allow get: if admin();
      allow list, delete: if false;
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['schema', 'revision', 'payload', 'updatedBy', 'updatedAt'])
          && d.keys().hasOnly(['schema', 'revision', 'payload', 'updatedBy', 'updatedAt'])
          && d.schema == 1 && d.revision is int && d.revision > 0
          && d.payload is string && d.payload.size() <= 200000
          && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
      }
      allow create: if admin() && valid() && request.resource.data.revision == 1;
      allow update: if admin() && valid() && request.resource.data.revision == resource.data.revision + 1;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
